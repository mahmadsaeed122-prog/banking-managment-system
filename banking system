         if(cin.fail() || amount <= 0) { 
		 cin.clear(); 
		 cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
		 cout<<"Invalid amount!\n"; 
		 return; 
		 }
        if (amount <= 0) {
            cout << "Invalid amount! Must be positive." << endl;
            return;
        }

        if (fromAcc == toAcc) {
            cout << "Cannot transfer to same account." << endl;
            return;
        }

        Account* from = findAccount(fromAcc);
        Account* to = findAccount(toAcc);

        if (from == NULL || to == NULL) {
            cout << "Account not found." << endl;
            return;
        }

        if (from->balance >= amount) {
            from->balance -= amount;
            to->balance += amount;
            recentTransaction.enqueue(fromAcc, "TRANSFER_OUT", amount, getCurrentTime());
            recentTransaction.enqueue(toAcc, "TRANSFER_IN", amount, getCurrentTime());
            cout << "Transfer successful." << endl;
            saveAccounts();
        } else {
            cout << "Not enough balance." << endl;
        }
    }

    void deleteAccount() {
        int accNo;
        cout << "Enter account number to delete: ";
        cin >> accNo;
        if (cin.fail() || accNo<= 0) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid amount! Amount must be positive." << endl;
        return;
       }
        Account* acc = findAccount(accNo);
        if (acc == NULL) {
            cout << "Account not found!" << endl;
            return;
        }

        if (acc->loanAmount > 0) {
            cout << "Cannot delete account! Outstanding loan: $" << acc->loanAmount << endl;
            return;
        }

        if (acc->pre == NULL && acc->next == NULL) {
            accountHead = accountTail = NULL;
        } else if (acc->pre == NULL) {
            accountHead = acc->next;
            accountHead->pre = NULL;
        } else if (acc->next == NULL) {
            accountTail = acc->pre;
            accountTail->next = NULL;
        } else {
            acc->pre->next = acc->next;
            acc->next->pre = acc->pre;
        }
        
        recentTransaction.enqueue(accNo, "ACC_DELETED", 0, getCurrentTime());
        delete acc;
        saveAccounts();
        cout << "Account deleted!" << endl;
    }

