    void applyForLoan() {
        int accNo, months;
        double amount;

        cout << "Enter account number: ";
        cin >> accNo;
        if (cin.fail() || amount <= 0) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid amount! Amount must be positive." << endl;
       return;
      }
        Account* acc = findAccount(accNo);
        if (acc == NULL) {
            cout << "Account not found!" << endl;
            return;
        }

        if (acc->loanAmount > 0) {
            cout << "You already have an outstanding loan: $" << acc->loanAmount << endl;
            return;
        }

        cout << "Enter the loan amount: ";
        cin >> amount;
        if (cin.fail() || amount <= 0) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid amount! Amount must be positive." << endl;
        return;
        }
        if (amount <= 0) {
            cout << "Invalid amount." << endl;
            return;
        }

        cout << "Loan duration (months): ";
        cin >> months;
        if (cin.fail() || amount <= 0) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid amount! Amount must be positive." << endl;
        return;
      }
        if (months <= 0) {
            cout << "Invalid month amount." << endl;
            return;
        }

        double interest = calculateLoanInterest(amount, months);
        double totalPayable = amount + interest;

        cout << "Loan amount: $" << amount << endl;
        cout << "Loan period: " << months << " months" << endl;
        cout << "Interest rate: 30% per year" << endl;
        cout << "Total interest: $" << interest << endl;
        cout << "Total payable: $" << totalPayable << endl;

        char confirm;
        cout << "Confirm loan application? (y/n): ";
        cin >> confirm;

        if (confirm == 'y' || confirm == 'Y') {
            acc->loanAmount = amount;
            acc->loanInterest = interest;
            acc->balance += amount;

            recentTransaction.enqueue(accNo, "LOAN_TAKEN", amount, getCurrentTime());
            cout << "Loan approved! $" << amount << " added to your account." << endl;
            cout << "New balance: $" << acc->balance << endl;
            saveAccounts();
        } else {
            cout << "Loan cancelled." << endl;
        }
    }

    void payLoan() {
        int accNo;
        double amount;
        cout << "Enter account number: ";
        cin >> accNo;
        if (cin.fail() || amount <= 0) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid amount! Amount must be positive." << endl;
        return;
        }
        Account* acc = findAccount(accNo);
        if (acc == NULL) {
            cout << "Account not found." << endl;
            return;
        }
        if (acc->loanAmount <= 0) {
            cout << "No outstanding loan." << endl;
            return;
        }

        double totalLoan = acc->loanAmount + acc->loanInterest;
        cout << "\n=== LOAN DETAILS ===" << endl;
        cout << "LOAN AMOUNT: $" << acc->loanAmount << endl;
        cout << "Interest: $" << acc->loanInterest << endl;
        cout << "Total Payable: $" << totalLoan << endl;

        cout << "Enter payment amount: $";
        cin >> amount;
        if (cin.fail() || amount <= 0) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid amount! Amount must be positive." << endl;
        return;
       }
        if (amount <= 0) {
            cout << "Invalid amount." << endl;
            return;
        }

        if (amount > acc->balance) {
            cout << "Insufficient balance!" << endl;
            return;
        }

        if (amount >= totalLoan) {
            acc->balance -= totalLoan;
            acc->loanAmount = 0;
            acc->loanInterest = 0;
            cout << "Loan fully paid!" << endl;
        } else {
            acc->loanInterest -= amount;
            if (acc->loanInterest < 0) {
                acc->loanAmount += acc->loanInterest; // negative interest reduces principal
                acc->loanInterest = 0;
            }
            acc->balance -= amount;
            cout << "Partial loan payment made." << endl;
        }

        recentTransaction.enqueue(accNo, "LOAN_PAYMENT", amount, getCurrentTime());
        saveAccounts();
        cout << "New balance: $" << acc->balance << endl;
    }

    void transferMoney() {
        int fromAcc, toAcc;
        double amount;

        cout << "Enter your account: ";
        cin >> fromAcc;
        if(cin.fail()) { 
		cin.clear(); 
		cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
		cout<<"Invalid account number!\n"; 
		return; 
		}
        cout << "Enter receiver account: ";
        cin >> toAcc;
        if(cin.fail()) { cin.clear(); 
		cin.ignore(numeric_limits<streamsize>::max(), '\n');
		 cout<<"Invalid account number!\n"; 
		 return; 
		 }
        cout << "Enter amount: ";
