    double balance;
    double loanAmount;
    double loanInterest; 
    Account* next;
    Account* pre; 
  
};
// -------structure to store the transaction history of the account hold by the user--------------.
struct Transaction {
    int accountNumber;
    string type;
    double amount;
    string timestamp;
    Transaction* next;
};
// ***************class of transcation of the customer account using queue********************************
class TransactionQueue {
private:
    Transaction* front;
    Transaction* rear;
    int size;
    const int max_size;

public:
    TransactionQueue() : front(NULL), rear(NULL), size(0), max_size(10) {}

    void enqueue(int accNo, string type, double amount, string time) {
        Transaction* newTransaction = new Transaction();
        newTransaction->accountNumber = accNo;
        newTransaction->type = type;
        newTransaction->amount = amount;
        newTransaction->timestamp = time;
        newTransaction->next = NULL;

        if (rear == NULL) {
            front = rear = newTransaction;
        } else {
            rear->next = newTransaction;
            rear = newTransaction;
        }

        size++;
        if (size > max_size) {
            dequeue();
        }
    }

    void dequeue() {
        if (front == NULL) return;
        Transaction* temp = front;
        front = front->next;
        if (front == NULL) rear = NULL;
        delete temp;
        size--;
    }

    void display() {
        if (front == NULL) {
            cout << "No recent transactions." << endl;
            return;
        }

        cout << "Transaction records:" << endl;
        cout << "Account\tType\tAmount\tTime" << endl;
        cout << "----------------------------" << endl;
        Transaction* temp = front;
        while (temp != NULL) {
            cout << temp->accountNumber << "\t" << temp->type;
            if (temp->type.length() < 8) cout << "\t";
            if (temp->type.length() < 4) cout << "\t";
            cout << "\t" << temp->amount << "\t" << temp->timestamp << endl;
            temp = temp->next;
        }
    }

    int getSize() { return size; }
    bool isEmpty() { return front == NULL; }
};

