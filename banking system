    newAccount->pre = NULL;

    if (accountHead == NULL) {
        accountHead = accountTail = newAccount;
    } else {
        accountTail->next = newAccount;
        newAccount->pre = accountTail;
        accountTail = newAccount;
    }

    if (accNo >= accountCounter) accountCounter = accNo + 1;
}


